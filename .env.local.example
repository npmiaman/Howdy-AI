# Howdy — environment variables. Copy to .env.local and fill in.
# Production values live in Vercel → Settings → Environment Variables.

# ─── Core services ───────────────────────────────────────────────────────────
# Gemini (chat + embeddings): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# AgentMail (all email in and out): https://console.agentmail.to
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=howdyai@agentmail.to
# Supabase → Project Settings → API. Apply supabase/migrations/0001…0006 in order.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ────────────────────────────────────────────────────────────────
# Shared with the scheduler that hits /api/howdy/process-pending (openssl rand -hex 32).
CRON_SECRET=
# The AgentMail webhook's Svix signing secret (starts with whsec_). Required in
# production — the webhook refuses to run there without it.
AGENTMAIL_WEBHOOK_SECRET=

# ─── Safety switches ─────────────────────────────────────────────────────────
# Saga email (invites, shortlists, intros, check-ins, nudges) is logged, not
# sent, unless this is exactly "false".
HOWDY_OUTREACH_DRYRUN=true
# While dry-run is on, emails to these addresses really go out — for testing
# the full flow on yourself. Comma-separated.
HOWDY_DRYRUN_ALLOWLIST=

# ─── Team ────────────────────────────────────────────────────────────────────
# Ops alerts go here (comma-separated; first is To, rest are Cc).
HOWDY_NOTIFY_EMAIL=
# Senders Howdy never answers as a client (defaults: the Bridge Creatives domains).
HOWDY_TEAM_DOMAINS=bridgecreativesagency.com,bridgecreatives.co
HOWDY_TEAM_EMAILS=
# Used in links inside emails.
NEXT_PUBLIC_SITE_URL=https://www.bridgecreatives.co

# ─── Limits and billing ──────────────────────────────────────────────────────
# HOWDY_DAILY_AI_TURNS=500           # AI turns per day across chat + inbound email
# HOWDY_CHAT_PER_SESSION=20          # chat messages per visitor session per day
# HOWDY_CHAT_PER_IP_HOUR=60
# HOWDY_FORM_PER_IP_HOUR=5           # hire + apply form submissions
# HOWDY_INBOUND_PER_SENDER_HOUR=20
# HOWDY_MATCH_FEE_USD=50             # recorded per intro (billable_intros)
# HOWDY_DIGEST_HOUR_UTC=1            # daily ops digest (01:00 UTC ≈ 9am SGT)
# HOWDY_AUTO_LABEL_SINCE=2026-09-29T00:00:00Z  # takeover ignores older outbound mail

# ─── Optional ────────────────────────────────────────────────────────────────
# Second Postgres that mirrors every thread/message (redundancy).
# MIRROR_DATABASE_URL=
# Pin a specific model: the "-latest" alias moves silently (on 2026-09-29 it
# resolved to gemini-3.8-flash, which took 17–62s per call). Production uses:
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=LOW          # LOW | MEDIUM | HIGH — unset = model default
# GEMINI_MAX_RETRIES=1
# HOWDY_WEBHOOK_DEADLINE_MS=50000    # alert ops before Vercel's 60s kill
# GEMINI_EMBED_MODEL=gemini-embedding-001
# HOWDY_CONNECT_DELAY_MIN=5
# HOWDY_BUSINESS_HOURS_START=9
# HOWDY_BUSINESS_HOURS_END=16
